# Copy to ~/.config/gramforge/config.env and fill in deployment-specific values.

# Optional Matrix notifications. Uncomment all three to enable them.
# MATRIX_HOMESERVER=https://matrix.example.com
# MATRIX_ROOM_ID=!roomid:example.com
# MATRIX_ACCESS_TOKEN=replace-me

# Optional publishing destination. Uncomment both to publish newly patched APKs.
# APK_PUBLIC_DIR=/srv/gramforge-apks
# APK_PUBLIC_URL=https://downloads.example.com/private-apks

# Private signing key. Keep this outside the repository.
GRAMFORGE_KEYSTORE=$HOME/.config/gramforge/signing.keystore

# Instagram navigation customization.
HIDE_HOME=true
HIDE_REELS=false
HIDE_DIRECT=false
HIDE_SEARCH=false
HIDE_PROFILE=false
HIDE_CREATE=false
